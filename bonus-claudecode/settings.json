{
  "//": "Bonus lab: a least-privilege Claude Code config. Deny-by-default permissions plus a PreToolUse hook that scans shell commands before they run.",
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Bash(python -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(rm -rf:*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(**/.env)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ./hooks/scan_command.py"
          }
        ]
      }
    ]
  }
}
